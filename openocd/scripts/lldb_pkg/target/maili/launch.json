        {
            "type": "lldb",
            "request": "attach",
            "name": "Attach",
            "breakpointMode": "file",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue false",
                "settings set target.prefer-dynamic-value no-dynamic-values",
                "settings set target.enable-synthetic-value false",
                "platform select remote-linux",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "set_chipset -s ${config:CHIPSET}",
                "meta_dir -s ${config:META_PATH}",
                "settings set target.default-arch ${config:ARCH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "settings set plugin.dynamic-loader.darwin-kernel.scan-type none",
                "protocol-server start MCP listen://localhost:59999"
            ],
            "processCreateCommands":
            [
                "connect_remote -s ${input:subsystemName}"
            ],
            "exitCommands": [
                "br del",
                "protocol-server stop MCP"
            ]
        },
