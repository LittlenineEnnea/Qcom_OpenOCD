<pmic_config>    
    <chipset name="qcs9100" >
        <source_config>
            <boot func = "sbl1_main_ctl" end = "boot_images/"> </boot>
            <tz  func = "tzbsp_boot" end= "trustzone_images/"> </tz>
        </source_config>
        <arch>
            <apss arch = "aarch64"  gdbPort = "3333" > </apss>
        </arch>
        <adi>
            <version adi_version= "5"> </version>
        </adi>
        <sleep_config>
            <pmic_sleep sleep_time = "0" > </pmic_sleep>
        </sleep_config>
        <hyp_config>
            <QHEE_ENTRY_VECTOR_ADDR address=""> </QHEE_ENTRY_VECTOR_ADDR>
            <GUNY_ENTRY_VECTOR_ADDR address="0x90000000"> </GUNY_ENTRY_VECTOR_ADDR>
        </hyp_config>
        <wdog_config>
            <!-- WDOG control register address can be read from ipcat (just search for WDOG_CTL_REG)-->
            <WDOG_CTL_REG reg = "0xC230004"> </WDOG_CTL_REG>
        </wdog_config>
        <file_info>
            <sec_dll_path path = "boot_images/Build/LeMansLAA/Core/DEBUG_CLANG140LINUX/AARCH64/QcomPkg/XBLCore/XBLCore/DEBUG/Sec.dll"> </sec_dll_path>
        </file_info>
        <configure_target>
        	<UefiRamEntryAddr Addr = "0xAF000000"></UefiRamEntryAddr>
