// @file launch.json
//
// @section Description
// This file defines configurations for how the debugger should behave when launching or attaching to an application.
{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "chipset": "aspen",
    "inputs": [
        {
            "id": "subsystemName",
            "type": "pickString",
            "description": "Select the subsystem to attach to",
            "options": [
                "apss"
            ],
            "default": "apss"
        }
    ],
    "configurations": [ 
        {
            "type": "lldb",
            "request": "attach",
            "name": "PBL Debug",
            "breakpointMode": "file",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue false",
                "settings set target.prefer-dynamic-value no-dynamic-values",
                "settings set target.enable-synthetic-value false",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "set_chipset -s ${config:CHIPSET}",
                "meta_dir -s ${config:META_PATH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "protocol-server start MCP listen://localhost:59999"
            ],
            "processCreateCommands":
            [
                 "debug -d pbl ${config:PBL_BIN_PATH}"
            ],
            "exitCommands": [
                "br del",
                "protocol-server stop MCP"
            ]
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "XBL Debug",
            "breakpointMode": "file",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue true",
                "settings set target.prefer-dynamic-value no-dynamic-values",
                "settings set target.enable-synthetic-value false",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "meta_dir -s ${config:META_PATH}",
                "source_path -i boot -p ${config:BOOT_SRC_PATH}",
                "image_path -i boot -s ${config:BOOT_BUILD_PATH}",
                "binary_path -i boot -s ${config:BOOT_BIN_PATH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "protocol-server start MCP listen://localhost:59999"
            ],
            "processCreateCommands":
            [
                 "debug -d xbl"
            ],
            "exitCommands": [
                "br del",
                "protocol-server stop MCP"
            ]
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "TZ Debug",
            "breakpointMode": "file",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue false",
                "settings set target.prefer-dynamic-value no-dynamic-values",
                "settings set target.enable-synthetic-value false",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "meta_dir -s ${config:META_PATH}",
                "source_path -i tz -p ${config:TZ_SRC_PATH}",
                "image_path -i tz -s ${config:TZ_BUILD_PATH}",
                "binary_path -i tz -s ${config:TZ_BIN_PATH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "protocol-server start MCP listen://localhost:59999"
            ],
            "processCreateCommands":
            [
                "debug -d tz"
            ],
            "exitCommands": [
                "br del",
                "protocol-server stop MCP"
            ]
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "HYP Debug",
            "breakpointMode": "file",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue false",
                "settings set target.prefer-dynamic-value no-dynamic-values",
                "settings set target.enable-synthetic-value false",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "meta_dir -s ${config:META_PATH}",
                "source_path -i tz -p ${config:TZ_SRC_PATH}",
                "image_path -i tz -s ${config:TZ_BUILD_PATH}",
                "binary_path -i tz -s ${config:HYP_BIN_PATH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "protocol-server start MCP listen://localhost:59999"
            ],
            "processCreateCommands":
            [
                "debug -d hyp"
            ],
            "exitCommands": [
                "br del",
                "protocol-server stop MCP"
            ]
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "UEFI Debug",
            "breakpointMode": "file",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue false",
                "settings set target.prefer-dynamic-value no-dynamic-values",
                "settings set target.enable-synthetic-value false",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "meta_dir -s ${config:META_PATH}",
                "source_path -i boot -p ${config:BOOT_SRC_PATH}",
                "image_path -i boot -s ${config:BOOT_BUILD_PATH}",
                "binary_path -i boot -s ${config:BOOT_BIN_PATH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "protocol-server start MCP listen://localhost:59999"
            ],
            "processCreateCommands":
            [
                "debug -d uefi",
                "debug -d uefi -i ${config:UEFI_DXE_NAME}"
            ],
            "exitCommands": [
                "br del",
                "protocol-server stop MCP"
            ]
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "APSS Debug",
            "breakpointMode": "file",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue false",
                "settings set target.prefer-dynamic-value no-dynamic-values",
                "settings set target.enable-synthetic-value false",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "meta_dir -s ${config:META_PATH}",
                "source_path -i apss -p ${config:APSS_SRC_PATH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "protocol-server start MCP listen://localhost:59999"
            ],
            "processCreateCommands":
            [
                "debug -d apss -p ${config:APSS_BIN_PATH} -s 2"
            ],
            "exitCommands": [
                "br del",
                "protocol-server stop MCP"
            ]
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "Attach",
            "breakpointMode": "file",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue false",
                "settings set target.prefer-dynamic-value no-dynamic-values",
                "settings set target.enable-synthetic-value false",
                "platform select remote-linux",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "set_chipset -s ${config:CHIPSET}",
                "meta_dir -s ${config:META_PATH}",
                "settings set target.default-arch ${config:ARCH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "settings set plugin.dynamic-loader.darwin-kernel.scan-type none",
                "protocol-server start MCP listen://localhost:59999"
            ],
            "processCreateCommands":
            [
                "connect_remote -s ${input:subsystemName}"
            ],
            "exitCommands": [
                "br del",
                "protocol-server stop MCP"
            ]
        },
        // {
        //     "type": "lldb",
        //     "request": "attach",
        //     "name": "Shell",
        //     "breakpointMode": "file",
        //     "targetCreateCommands": [
        //         "settings set auto-confirm on",
        //         "settings set target.skip-prologue false",
        //         "settings set target.prefer-dynamic-value no-dynamic-values",
        //         "settings set target.enable-synthetic-value false",
        //         "platform select remote-linux",
        //         "script os.chdir(\"scripts\")",
        //         "command script import openocd_lldb.py",
        //         "meta_dir -s ${config:META_PATH}",
        //         "settings set target.default-arch aarch64",
        //     ],
        //     "exitCommands": [
        //         "br del"
        //     ]
        // },
        {
            "type": "lldb",
            "request": "attach",
            "name": "ADSP DEBUG - STEP 1",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "meta_dir -s ${config:META_PATH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}"
            ],
            "processCreateCommands":
            [
                "q6_entry -s ${config:Q6_SUBSYSTEM}",
                "c",
                "debugwithpil -s ${config:Q6_SUBSYSTEM} -w True"
            ]
        },
        {
            //  ADSP : Root PD debug - WIP
            "type": "lldb",
            "request": "attach",
            "name": "ADSP DEBUG - STEP 2",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue false",
                "settings set target.process.disable-memory-cache true",
                "setting set plugin.process.gdb-remote.packet-timeout 1000000",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "meta_dir -s ${config:META_PATH}",
                "source_path -i ${config:Q6_SUBSYSTEM} -p ${config:Q6_SRC_PATH}",
                "image_path -i ${config:Q6_SUBSYSTEM} -s ${config:Q6_BUILD_PATH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "protocol-server start MCP listen://localhost:60001"
            ],
            "processCreateCommands":
            [
                "root_pd_debug -o ${config:Q6_SUBSYSTEM} -e ${config:Q6_DEBUG_ENTRY}"
            ]
        },
        {
            
            "type": "lldb",
            "request": "attach",
            "name": "AWM Debug",
            "breakpointMode": "file",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue false",
                "setting set plugin.process.gdb-remote.packet-timeout 1000000",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "meta_dir -s ${config:META_PATH}",
                "image_path -i awm -s ${config:AWM_BUILD_PATH}",
                "source_path -i awm -p ${config:AWM_SRC_PATH}",
                "binary_path -i awm -s ${config:AWM_BIN_PATH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "protocol-server start MCP listen://localhost:60005"
            ],
            "processCreateCommands":
            [
                "debug -d awm"
            ],
            "exitCommands": [
                "br del",
                "protocol-server stop MCP"
            ]
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "SWM Debug",
            "breakpointMode": "file",
            "targetCreateCommands": [
                "settings set auto-confirm on",
                "settings set target.skip-prologue false",
                "setting set plugin.process.gdb-remote.packet-timeout 1000000",
                "script os.chdir(\"scripts\")",
                "command script import openocd_lldb.py",
                "meta_dir -s ${config:META_PATH}",
                "image_path -i swm -s ${config:SWM_BUILD_PATH}",
                "source_path -i swm -p ${config:SWM_SRC_PATH}",
                "binary_path -i swm -s ${config:SWM_BIN_PATH}",
                "debug_adapter -d ${config:ADAPTER} ${config:PROTOCOL}",
                "gdb_remote_host -s ${config:GDB_REMOTE_HOST}",
                "protocol-server start MCP listen://localhost:60006"
            ],
            "processCreateCommands":
