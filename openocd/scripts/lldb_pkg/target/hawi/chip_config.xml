<pmic_config>    
    <chipset name="hawi" >
        <source_config>
            <boot func = "sbl1_main_ctl" end = "xbl_images/"> </boot>
            <tz  func = "tzbsp_boot" end= "trustzone_images/"></tz>
            <hyp  func = "boot_cold_init" end= "hypervisor_images/"></hyp>
            <mpss  func = "main" end= "oem/"></mpss>
            <soccp func="main" end="/soccp_proc/"></soccp>
        </source_config>
        <arch>
            <apss3 arch = "aarch64" gdbPort = "3336" > </apss3>
            <cdsp arch = "hexagon" gdbPort = "3002" > </cdsp>
            <mpss arch = "hexagon" gdbPort = "3003" > </mpss>
            <soccp arch = "riscv"  gdbPort = "3100" > </soccp>
        </arch>
        <adi>
            <version adi_version= "6">  </version>
        </adi>
        <wdog_config>
            <!-- WDOG control register address can be read from ipcat (just search for WDOG_CTL_REG)-->
            <WDOG_CTL_REG reg="0x20C24004"> </WDOG_CTL_REG>
            <APSS_WDT_TMR1_WDOG_CTL reg = "0x17600008" > </APSS_WDT_TMR1_WDOG_CTL>
            <APSS_WDT_TMR2_WDOG_CTL reg = "0x17908008" > </APSS_WDT_TMR2_WDOG_CTL>
        </wdog_config>
        <hyp_config>
            <QHEE_ENTRY_VECTOR_ADDR address="0x80080000"> </QHEE_ENTRY_VECTOR_ADDR>
            <GUNY_ENTRY_VECTOR_ADDR address="0x80000000"> </GUNY_ENTRY_VECTOR_ADDR>
        </hyp_config>
        <sleep_config>
            <pmic_sleep sleep_time = "0" > </pmic_sleep>
        </sleep_config>
        <uefi_config>
            <QHEE_ENTRY_VECTOR_ADDR address="0x80080000"> </QHEE_ENTRY_VECTOR_ADDR>
            <GUNY_ENTRY_VECTOR_ADDR address="0x80000000"> </GUNY_ENTRY_VECTOR_ADDR>
        </uefi_config>
        <configure_target>
            <UefiRamEntryAddr Addr = "0xC6800000"></UefiRamEntryAddr> 
            <RamFvAddr Addr = "0xC6400000"></RamFvAddr>
            <InfoBlkPtrOffset Addr = "0x00E00000"></InfoBlkPtrOffset>
            <SharedImemAddress Addr = "0x14680000"></SharedImemAddress>
            <Arch Arch= "64"></Arch>
            <CoreObj path="uefi_images/Build/HawiDefaultPkg/DEBUG_CLANGDWARF/AARCH64"> </CoreObj>
        </configure_target>
        <InitOffsets>
            <ArchString ArchString="64-bit"></ArchString>
            <PtrSize PtrSize="0x8"></PtrSize>
            <BinFolder BinFolder="Bin64"></BinFolder>
            <EfiHeaderOffset Offset ="0x260"></EfiHeaderOffset>
            <SecLoadAddrOffset Offset ="0x1000"></SecLoadAddrOffset>
            <RvaOffsetAdd Offset ="0x102C"></RvaOffsetAdd>
            <ImgBaseDbgEntryOffset Offset ="0x138"></ImgBaseDbgEntryOffset>
            <RvaOffsetSub Offset ="0xC4"></RvaOffsetSub>
            <STCfgTbl Offset ="0x70"></STCfgTbl>
            <STCfgItemCnt Offset ="0x68"></STCfgItemCnt>
            <MemMapGcdOffset Offset ="0x14"></MemMapGcdOffset>
            <GcdBaseOffset Offset ="0x4"></GcdBaseOffset>
            <GcdEndOffset Offset ="0xC"></GcdEndOffset>
            <GcdAttribOffset Offset ="0x1C"></GcdAttribOffset>
            <RvaOffset Offset ="0x1758"></RvaOffset>
            <CoreLoadPeImageOffset Offset ="249"></CoreLoadPeImageOffset>
            <IBlkUartLogBufferPtr Offset ="0x40"></IBlkUartLogBufferPtr>
            <IBlkUartLogBufferTotalSize Offset ="0x40"></IBlkUartLogBufferTotalSize>
            <IBlkRuntimeDbgTablePtr Offset ="0x70"></IBlkRuntimeDbgTablePtr>
            <IBlkRtDbgTableEntryCnt Offset ="0x78"></IBlkRtDbgTableEntryCnt>
            <IBlkSystemTablePtr Offset ="0x68"></IBlkSystemTablePtr>
            <IBlkDxeSymbolAddr Offset ="0x90"></IBlkDxeSymbolAddr>
            <IBlkConfigTablePtr Offset ="0x60"></IBlkConfigTablePtr>
            <IBlkHobBaseOffset Offset ="0x38"></IBlkHobBaseOffset>
            <IBlkCmdStartOffset Offset ="0x98"></IBlkCmdStartOffset>
            <IBlkTotalCmdSize Offset ="0xA0"></IBlkTotalCmdSize>
            <IBlkSymbolCmdString Offset ="0xA8"></IBlkSymbolCmdString>
            <IBlkLoaderBkpt Offset ="0xB0"></IBlkLoaderBkpt>
            <IBlkDbgStopDrvrStr Offset ="0xB8"></IBlkDbgStopDrvrStr>
            <IBlkModuleName Offset ="0xD8"></IBlkModuleName>
            <IBlkSymbolCmdSize Offset ="0xF8"></IBlkSymbolCmdSize>
            <IBlkLastCmdSize Offset ="0x100"></IBlkLastCmdSize>
            <IBlkBdsHotkey Offset ="0x108"></IBlkBdsHotkey>
            <IBlkCrashContext Offset ="0x128"></IBlkCrashContext>
            <IBlkForceDisableHWWdog Offset ="0x110"></IBlkForceDisableHWWdog>
        </InitOffsets>
        <adsp_config>
            <ukernel_path ukernel_file='UKERNEL_kaanapali.adsp.prodQ.elf'> </ukernel_path>
            <hw_threads thrd_num= "6"> </hw_threads>
            <tlb_entries tlb_num= "256"> </tlb_entries> 
            <wdog_ctl wdog= "0x6884004"></wdog_ctl>     
            <etm_clk_reg etm_clk= "0x81348000"> </etm_clk_reg>
            <!-- QDSS_MSS_QDSP6_QDSP6_ETM_CLK_EN  -->
            <etm_clk_reg etm_clk= "0x81348008"> </etm_clk_reg> 
            <!-- QDSS_MSS_QDSP6_QDSP6_ETM_RESET  -->             
            <core_clk_reg core_clk = "0x147000"> </core_clk_reg>
            <core_clk_reg core_clk= "0x14700C"> </core_clk_reg>
            <core_clk_reg core_clk= "0x6E1101C"> </core_clk_reg>
            <!-- checking -->
            <core_clk_reg core_clk= "0x6E1001C"> </core_clk_reg>
            <!-- checking -->
            <core_clk_reg core_clk= "0x6E12020"> </core_clk_reg>
            <core_clk_reg core_clk= "0x6E12014"> </core_clk_reg>
            <core_clk_reg core_clk= "0x6800018"> </core_clk_reg>
            <core_clk_reg core_clk= "0x6E12058"> </core_clk_reg>
            <root_path root_path='ROOT_kaanapali.adsp.prodQ.elf'> </root_path>           
        </adsp_config>
		<cdsp_config>
            <ukernel_path ukernel_file='UKERNEL_kaanapali.cdsp.prodQ.elf'> </ukernel_path>
            <hw_threads thrd_num= "12"> </hw_threads>
            <tlb_entries tlb_num= "128"> </tlb_entries> 
            <wdog_ctl wdog= "0x11008000"></wdog_ctl>     
            <!-- <etm_clk_reg etm_clk= "0x11008008"> </etm_clk_reg> -->
            <!-- 0x11190000 -->
            <etm_clk_reg etm_clk= "0x81190000"> </etm_clk_reg>
            <!-- QDSS_MSS_QDSP6_QDSP6_ETM_CLK_EN  -->
            <etm_clk_reg etm_clk= "0x81190008"> </etm_clk_reg> 
            <!-- QDSS_MSS_QDSP6_QDSP6_ETM_RESET  -->             
            <root_path root_path='ROOT_kaanapali.cdsp.prodQ.elf'> </root_path>           
        </cdsp_config>
        <mpss_config>
            <ukernel_path ukernel_file='orig_MODEM_PROC_IMG_kaanapali.gen.testQ.elf'> </ukernel_path>
            <hw_threads thrd_num= "8"> </hw_threads>
            <tlb_entries tlb_num= "256"> </tlb_entries> 
            <wdog_ctl wdog= "0x4484004"></wdog_ctl>     
            <etm_clk_reg etm_clk= "0x81010000"> </etm_clk_reg>
            <!-- QDSS_MSS_QDSP6_QDSP6_ETM_CLK_EN  -->
            <etm_clk_reg etm_clk= "0x81010000"> </etm_clk_reg> 
            <!-- QDSS_MSS_QDSP6_QDSP6_ETM_RESET  -->             
            <root_path root_path='OEMPD_IMG_kaanapali.gen.testQ.elf'> </root_path>           
        </mpss_config>
        <wake_cpu0>
            <write reg="0x11311FB0" value ="0xc5acce55"> </write>
            <write reg="0x11311060" value ="0x0"> </write>
            <write reg="0x113110DC" value ="0x0"> </write>
            <write reg="0x11311FB0" value ="0xa5a5a5a5"> </write>
        </wake_cpu0>
        <riscv_config>
            <soccp_config>
                <soccp_debug_base addr="0x913A8000"> </soccp_debug_base>
                <dmcontrol offset_addr="0x40" dmcontrol_data_1="0x1" dmcontrol_data_2="0x80000009"> </dmcontrol>
            </soccp_config>
        </riscv_config>
    </chipset>
</pmic_config>
