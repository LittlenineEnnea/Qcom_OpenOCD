            <hw_threads thrd_num= "6"> </hw_threads>
            <tlb_entries tlb_num= "256"> </tlb_entries> 
            <wdog_ctl wdog= "0x6884004"></wdog_ctl>     
            <etm_clk_reg etm_clk= "0x81348000"> </etm_clk_reg>
