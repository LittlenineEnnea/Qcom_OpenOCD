<pmic_config>    
    <chipset name="Kobuk" >
        <source_config>
            <boot func = "sbl1_main_ctl" end = "boot_images/"> </boot>
            <tz  func = "tzbsp_boot" end= "trustzone_images/"> </tz>
            <mpss  func = "main" end= "oem/"></mpss>
        </source_config>
        <arch>
            <apss arch = "aarch64"  gdbPort = "3333"> </apss>
            <mpss arch = "hexagon"  gdbPort = "3003"> </mpss>
        </arch>
        <adi>
            <version adi_version= "6">  </version>
        </adi>
        <wdog_config>
            <!-- WDOG control register address can be read from ipcat (just search for WDOG_CTL_REG)-->
            <WDOG_CTL_REG reg="0x20C24004"> </WDOG_CTL_REG>
            <APSS_WDT_TMR1_WDOG_CTL reg = "0x17600008" > </APSS_WDT_TMR1_WDOG_CTL>
            <APSS_WDT_TMR2_WDOG_CTL reg = "0x17908008" > </APSS_WDT_TMR2_WDOG_CTL>
        </wdog_config>
        <hyp_config>
            <QHEE_ENTRY_VECTOR_ADDR address="0x80080000"> </QHEE_ENTRY_VECTOR_ADDR>
            <GUNY_ENTRY_VECTOR_ADDR address="0x80000000"> </GUNY_ENTRY_VECTOR_ADDR>
        </hyp_config>
        <sleep_config>
            <pmic_sleep sleep_time = "0" > </pmic_sleep>
        </sleep_config>
        <configure_target>
            <UefiRamEntryAddr Addr = "0xC6800000"></UefiRamEntryAddr> 
            <RamFvAddr Addr = "0xC72D9000"></RamFvAddr>
            <InfoBlkPtrOffset Addr = "0x00601000"></InfoBlkPtrOffset>
            <SharedImemAddress Addr = "0x14680000"></SharedImemAddress>
            <Arch Arch= "64"></Arch>
            <CoreObj path="boot_images/Build/kobukLAA/Core/DEBUG_CLANG180LINUX/AARCH64"> </CoreObj>
        </configure_target>
        <InitOffsets>
            <ArchString ArchString="64-bit"></ArchString>
            <PtrSize PtrSize="0x8"></PtrSize>
            <BinFolder BinFolder="Bin64"></BinFolder>
            <IBlkUartLogBufferPtr Offset ="0x38"></IBlkUartLogBufferPtr>
            <IBlkUartLogBufferLen Offset ="0x40"></IBlkUartLogBufferLen>
            <EfiHeaderOffset Offset ="0x260"></EfiHeaderOffset>
            <SecLoadAddrOffset Offset ="0x2000"></SecLoadAddrOffset>
            <IBlkRuntimeDbgTablePtr Offset ="0x88"></IBlkRuntimeDbgTablePtr>
            <IBlkRtDbgTableEntryCnt Offset ="0x90"></IBlkRtDbgTableEntryCnt>
            <IBlkSystemTablePtr Offset ="0x70"></IBlkSystemTablePtr>
            <IBlkDxeSymbolAddr Offset ="0x98"></IBlkDxeSymbolAddr>
            <RvaOffsetAdd Offset ="0x102C"></RvaOffsetAdd>
